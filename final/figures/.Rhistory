library(hilbert)
library(tidyverse)
library(hilbert)
data.frame(i = 1:1024) |>
mutate(hxy = position_to_coords(i)) |>
unnest_wider()
data.frame(i = 1:1024) |>
mutate(hxy = position_to_coords(i, extent = 10)) |>
unnest_wider()
?position_to_coords
data.frame(i = 1:1024) |>
mutate(hxy = position_to_coords(i, n = 10)) |>
unnest_wider()
?position
data.frame(i = 1:1024) |>
mutate(hxy = position(i, n = 10)) |>
unnest_wider()
data.frame(i = 1:1024) |>
mutate(hxy = position(i, n = 10)) |>
unnest_wider(col = "hxy")
data.frame(i = 1:1024) |>
mutate(hxy = position(i, n = 10)) |>
unnest_wider(col = "hxy") |>
ggplot() +
geom_path(aes(x = x, y = y))
data.frame(i = 1:1024) |>
mutate(hxy = position(i, n = 10)) |>
unnest_wider(col = "hxy") |>
ggplot() +
geom_path(aes(x = x, y = y)) +
coord_equal() +
theme_void()
data.frame(i = 0:4095) |>
mutate(hxy = position(i, n = 11)) |>
unnest_wider(col = "hxy") |>
ggplot() +
geom_path(aes(x = x, y = y)) +
coord_equal() +
theme_void()
data.frame(i = 1:(2^16) - 1) |>
mutate(hxy = position(i, n = 12)) |>
unnest_wider(col = "hxy") |>
ggplot() +
geom_path(aes(x = x, y = y)) +
coord_equal() +
theme_void()
2^14
data.frame(i = 1:(2^14) - 1) |>
mutate(hxy = position(i, n = 12)) |>
unnest_wider(col = "hxy") |>
ggplot() +
geom_path(aes(x = x, y = y)) +
coord_equal() +
theme_void()
data.frame(i = 1:(2^14) - 1) |>
mutate(hxy = position(i, n = 12)) |>
unnest_wider(col = "hxy") |>
tail()
data.frame(i = 1:(2^13) - 1) |>
mutate(hxy = position(i, n = 12)) |>
unnest_wider(col = "hxy") |>
ggplot() +
geom_path(aes(x = x, y = y)) +
coord_equal() +
theme_void()
data.frame(i = 1:(2^13) - 1) |>
mutate(hxy = position(i, n = 12)) |>
unnest_wider(hxy) |>
ggplot() +
geom_path(aes(x = x, y = y)) +
coord_equal() +
theme_void()
?unnest_wider
